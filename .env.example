# Copy to .env.local (local) or set in your hosting provider's environment settings.

# Google Apps Script web-app URL that appends RSVPs to your Google Sheet.
# See docs/rsvp-google-sheet.md. Without it, RSVPs are only logged in development.
RSVP_WEBHOOK_URL=

# Shared secret; must match SECRET in the Apps Script.
RSVP_WEBHOOK_SECRET=

# Public URL of the deployed invitation (used for link previews), e.g. https://dinura-sanuli.vercel.app
SITE_URL=
